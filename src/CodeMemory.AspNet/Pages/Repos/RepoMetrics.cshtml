@page "/Repos/{name}/RepoMetrics"
@model CodeMemory.AspNet.Pages.Repos.RepoMetricsModel
@using System.Text.Json
@using System.Text.Json.Serialization
@{
    ViewData["Title"] = Model.Repo?.Name ?? "Repo Metrics";
    var json = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    };

    var repoGauges = Model.RepoSnapshot?.Instruments
        .Where(i => i.Name.StartsWith("codememory.repo.")).ToList() ?? [];
    string? repoChartJson = null;
    if (repoGauges.Count > 0)
    {
        var chartSeries = repoGauges.OrderBy(i => i.Name).Select(instr =>
        {
            var key = instr.Name.Replace("codememory.repo.", "");
            var mv = instr.Values.FirstOrDefault();
            var meas = mv?.Measurements?.OrderBy(m => m.Timestamp)
                .Select(m => new { value = m.Value, timestamp = m.Timestamp.ToString("o") }).ToList() ?? [];
            return new { key, last = mv?.Last ?? meas.LastOrDefault()?.value ?? 0, measurements = meas };
        }).Where(d => d.measurements.Count > 0).ToList();
        repoChartJson = JsonSerializer.Serialize(chartSeries, json);
    }
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Repos</a></li>
        <li class="breadcrumb-item active">Repo Metrics</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Model.Repo?.Name<span class="text-muted fs-4 ms-2">Repo Metrics</span></h1>
    <div>
        <a asp-page="/Repos/Components" asp-route-name="@Model.Repo?.Name" class="btn btn-outline-info me-2">
            <i class="bi bi-boxes"></i> Components
        </a>
        <a asp-page="/Repos/Metrics" asp-route-name="@Model.Repo?.Name" class="btn btn-outline-warning me-2">
            📊 Metrics
        </a>
        <a asp-page="/Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</div>

@if (Model.NotFoundMessage is not null)
{
    <div class="alert alert-warning">@Model.NotFoundMessage</div>
}
else if (!Model.IsEnabled)
{
    <div class="alert alert-info">
        <h5 class="alert-heading"><i class="bi bi-info-circle"></i> Repo Metrics Not Available</h5>
        <p class="mb-0">
            Local (zero-infrastructure) metrics are not enabled.
            Set <code>LocalMetrics:Enabled: true</code> in <code>appsettings.json</code> to collect and display runtime metrics.
        </p>
    </div>
}
else if (Model.RepoSnapshot is null)
{
    <div class="alert alert-info">
        <h5 class="alert-heading"><i class="bi bi-graph-up"></i> No Metrics Yet</h5>
        <p class="mb-0">No repo metrics have been recorded for this repository. Metrics appear after indexing completes and tools are invoked.</p>
    </div>
}
else
{
    var snapshot = Model.RepoSnapshot;

    <div class="text-muted small mb-3">
        Snapshot collected at: <strong>@snapshot.CollectedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</strong>
        &middot; @snapshot.Instruments.Count instrument(s) with repo-scoped data
    </div>

    @* ── Group instruments by category ────────────────────── *@
    var toolInstr = snapshot.Instruments.FirstOrDefault(i => i.Name == "codememory.tools.invocations");
    var indexingInstr = snapshot.Instruments.Where(i => i.Name.StartsWith("codememory.indexing.")).ToList();
    var searchInstr = snapshot.Instruments.FirstOrDefault(i => i.Name == "codememory.search.query_duration");
    var sqlInstr = snapshot.Instruments.FirstOrDefault(i => i.Name == "codememory.sql.query_duration");
    var cloneInstr = snapshot.Instruments.FirstOrDefault(i => i.Name == "codememory.git.clone.duration");

    @* ── 1. Tool Invocations ──────────────────────────────── *@
    if (toolInstr is not null && toolInstr.Values.Count > 0)
    {
        var totalToolCalls = toolInstr.Values.Sum(v => v.Count ?? 0);
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="mb-0">Tool Invocations</h4>
                <span class="badge bg-secondary">@totalToolCalls.ToString("N0") total</span>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle table-sm">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Tool</th>
                                <th>Host</th>
                                <th class="text-end">Invocations</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var sortedTools = toolInstr.Values
                                    .OrderByDescending(v => v.Count ?? 0)
                                    .ToList();
                            }
                            @for (var i = 0; i < sortedTools.Count; i++)
                            {
                                var v = sortedTools[i];
                                var toolTag = v.Tags?.FirstOrDefault(t => t.Key == "tool").Value ?? "?";
                                var hostTag = v.Tags?.FirstOrDefault(t => t.Key == "host").Value ?? "—";
                                <tr>
                                    <td class="text-muted">@(i + 1)</td>
                                    <td><code>@toolTag</code></td>
                                    <td><span class="badge bg-info text-dark">@hostTag</span></td>
                                    <td class="text-end fw-semibold">@(v.Count?.ToString("N0") ?? "0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @* ── 2. Indexing Metrics ──────────────────────────────── *@
    if (indexingInstr.Count > 0)
    {
        <div class="card mb-4">
            <div class="card-header">
                <h4 class="mb-0">Indexing</h4>
            </div>
            <div class="card-body">
                @foreach (var instr in indexingInstr)
                {
                    var displayName = instr.Name.Replace("codememory.indexing.", "");
                    <h5 class="mt-3 mb-2">@displayName</h5>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-sm">
                            <thead class="table-dark">
                                <tr>
                                    @if (instr.InstrumentType == "histogram")
                                    {
                                        <th>Count</th>
                                        <th class="text-end">Sum</th>
                                        <th class="text-end">Avg</th>
                                        <th class="text-end">Min</th>
                                        <th class="text-end">Max</th>
                                        <th class="text-end">Last</th>
                                    }
                                    else
                                    {
                                        <th class="text-end">Value</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in instr.Values)
                                {
                                    <tr>
                                        @if (instr.InstrumentType == "histogram")
                                        {
                                            <td>@(v.Count?.ToString("N0") ?? "0")</td>
                                            <td class="text-end">@(v.Sum?.ToString("N2") ?? "—")</td>
                                            <td class="text-end">@(v.Count > 0 ? (v.Sum / v.Count)?.ToString("N2") : "—")</td>
                                            <td class="text-end">@(v.Min?.ToString("N2") ?? "—")</td>
                                            <td class="text-end">@(v.Max?.ToString("N2") ?? "—")</td>
                                            <td class="text-end">@(v.Last?.ToString("N2") ?? "—")</td>
                                        }
                                        else
                                        {
                                            <td class="text-end fw-semibold">@(v.Count?.ToString("N0") ?? "0")</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }

    @* ── 3. Search & SQL Queries ──────────────────────────── *@
    var queryInstrs = new[] { searchInstr, sqlInstr }.Where(i => i is not null).ToList();
    if (queryInstrs.Count > 0)
    {
        <div class="card mb-4">
            <div class="card-header">
                <h4 class="mb-0">Queries</h4>
            </div>
            <div class="card-body">
                @foreach (var instr in queryInstrs)
                {
                    var displayName = instr!.Name switch
                    {
                        "codememory.search.query_duration" => "Semantic Search",
                        "codememory.sql.query_duration" => "SQL Query",
                        var n => n.Replace("codememory.", "")
                    };
                    <h5 class="mt-3 mb-2">@displayName (ms)</h5>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-sm">
                            <thead class="table-dark">
                                <tr>
                                    <th>Count</th>
                                    <th class="text-end">Sum</th>
                                    <th class="text-end">Avg</th>
                                    <th class="text-end">Min</th>
                                    <th class="text-end">Max</th>
                                    <th class="text-end">Last</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in instr.Values)
                                {
                                    <tr>
                                        <td>@(v.Count?.ToString("N0") ?? "0")</td>
                                        <td class="text-end">@(v.Sum?.ToString("N2") ?? "—")</td>
                                        <td class="text-end">@(v.Count > 0 ? (v.Sum / v.Count)?.ToString("N2") : "—")</td>
                                        <td class="text-end">@(v.Min?.ToString("N2") ?? "—")</td>
                                        <td class="text-end">@(v.Max?.ToString("N2") ?? "—")</td>
                                        <td class="text-end">@(v.Last?.ToString("N2") ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }

    @* ── 4. Git / Clone ───────────────────────────────────── *@
    if (cloneInstr is not null && cloneInstr.Values.Count > 0)
    {
        <div class="card mb-4">
            <div class="card-header">
                <h4 class="mb-0">Git Clone (ms)</h4>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle table-sm">
                        <thead class="table-dark">
                            <tr>
                                <th>Count</th>
                                <th class="text-end">Sum</th>
                                <th class="text-end">Avg</th>
                                <th class="text-end">Min</th>
                                <th class="text-end">Max</th>
                                <th class="text-end">Last</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in cloneInstr.Values)
                            {
                                <tr>
                                    <td>@(v.Count?.ToString("N0") ?? "0")</td>
                                    <td class="text-end">@(v.Sum?.ToString("N2") ?? "—")</td>
                                    <td class="text-end">@(v.Count > 0 ? (v.Sum / v.Count)?.ToString("N2") : "—")</td>
                                    <td class="text-end">@(v.Min?.ToString("N2") ?? "—")</td>
                                    <td class="text-end">@(v.Max?.ToString("N2") ?? "—")</td>
                                    <td class="text-end">@(v.Last?.ToString("N2") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @* ── 5. Repo Overview Gauges ──────────────────────────── *@
    if (repoGauges.Count > 0)
    {
        var hasTrend = repoGauges.Any(i => (i.Values.FirstOrDefault()?.Measurements?.Count ?? 0) > 1);

        <div class="card mb-4">
            <div class="card-header">
                <h4 class="mb-0">Repository Overview</h4>
            </div>
            <div class="card-body">
                <div class="row g-2 mb-3" id="metricCards">
                    @foreach (var instr in repoGauges.OrderBy(i => i.Name))
                    {
                        var key = instr.Name.Replace("codememory.repo.", "");
                        var mv = instr.Values.FirstOrDefault();
                        var lastVal = mv?.Last ?? mv?.Measurements?.LastOrDefault()?.Value ?? 0;
                        var color = key switch
                        {
                            "classes" => "text-info",
                            "methods" => "text-success",
                            "interfaces" => "text-warning",
                            "properties" => "text-primary",
                            "fields" => "text-secondary",
                            "total_symbols" => "",
                            "total_files" => "",
                            "total_relationships" => "text-danger",
                            _ => ""
                        };
                        <div class="col-6 col-md-3 col-xl metric-card" data-metric="@key" role="button" style="cursor:pointer;" title="Click to toggle chart series">
                            <div class="card text-bg-dark h-100">
                                <div class="card-body text-center py-2">
                                    <div class="fs-3 fw-bold @color">@lastVal.ToString("N0")</div>
                                    <div class="small text-secondary">@key</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (hasTrend)
                {
                    <div style="position:relative; height:350px;">
                        <canvas id="repoTrendChart"></canvas>
                    </div>
                }
                else if (repoGauges.Any(i => i.Values.FirstOrDefault()?.Measurements?.Count > 0))
                {
                    <p class="text-muted small mb-0">Collect more data points to see the trend chart. Metrics are recorded after each indexing pass.</p>
                }
            </div>
        </div>
    }

    @* ── 6. Other Instruments ─────────────────────────────── *@
    var otherInstr = snapshot.Instruments
        .Where(i => i != toolInstr
            && i.Name != "codememory.search.query_duration"
            && i.Name != "codememory.sql.query_duration"
            && i.Name != "codememory.git.clone.duration"
            && !i.Name.StartsWith("codememory.indexing.")
            && !i.Name.StartsWith("codememory.repo."))
        .ToList();

    if (otherInstr.Count > 0)
    {
        <div class="card mb-4">
            <div class="card-header">
                <h4 class="mb-0">Other Instruments</h4>
            </div>
            <div class="card-body">
                @foreach (var instr in otherInstr)
                {
                    <h5 class="mt-3 mb-2"><code>@instr.Name</code> <span class="badge bg-secondary">@instr.InstrumentType</span></h5>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-sm">
                            <thead class="table-dark">
                                <tr>
                                    @if (instr.InstrumentType == "histogram")
                                    {
                                        <th>Count</th>
                                        <th class="text-end">Sum</th>
                                        <th class="text-end">Avg</th>
                                        <th class="text-end">Min</th>
                                        <th class="text-end">Max</th>
                                        <th class="text-end">Last</th>
                                    }
                                    else
                                    {
                                        <th class="text-end">Value</th>
                                    }
                                    @if (instr.Values.Any(v => v.Tags?.Count > 0))
                                    {
                                        <th>Tags</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in instr.Values)
                                {
                                    <tr>
                                        @if (instr.InstrumentType == "histogram")
                                        {
                                            <td>@(v.Count?.ToString("N0") ?? "0")</td>
                                            <td class="text-end">@(v.Sum?.ToString("N2") ?? "—")</td>
                                            <td class="text-end">@(v.Count > 0 ? (v.Sum / v.Count)?.ToString("N2") : "—")</td>
                                            <td class="text-end">@(v.Min?.ToString("N2") ?? "—")</td>
                                            <td class="text-end">@(v.Max?.ToString("N2") ?? "—")</td>
                                            <td class="text-end">@(v.Last?.ToString("N2") ?? "—")</td>
                                        }
                                        else
                                        {
                                            <td class="text-end fw-semibold">@(v.Count?.ToString("N0") ?? "0")</td>
                                        }
                                        @if (v.Tags?.Count > 0)
                                        {
                                            <td><code>@string.Join(", ", v.Tags.Select(t => $"{t.Key}={t.Value}"))</code></td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
}

@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            var rawData = @Html.Raw(repoChartJson ?? "[]");
            if (!rawData || rawData.length === 0) return;

            var metricColors = {
                total_symbols: '#0d6efd',
                total_files: '#198754',
                classes: '#0dcaf0',
                methods: '#ffc107',
                interfaces: '#fd7e14',
                properties: '#6f42c1',
                fields: '#6c757d',
                total_relationships: '#dc3545'
            };

            var leftAxis = new Set(['total_symbols', 'total_files', 'total_relationships']);

            var toSec = function (ts) {
                return new Date(Math.round(new Date(ts).getTime() / 1000) * 1000).toISOString();
            };

            var allTimestamps = new Set();
            rawData.forEach(function (s) {
                s.measurements.forEach(function (m) {
                    allTimestamps.add(toSec(m.timestamp));
                });
            });
            var labels = Array.from(allTimestamps).sort();

            var datasets = rawData.map(function (s) {
                return {
                    label: s.key,
                    data: labels.map(function (ts) {
                        var m = s.measurements.find(function (a) { return toSec(a.timestamp) === ts; });
                        return m ? m.value : null;
                    }),
                    borderColor: metricColors[s.key] || '#adb5bd',
                    backgroundColor: metricColors[s.key] || '#adb5bd',
                    borderWidth: 2,
                    pointRadius: 3,
                    pointHoverRadius: 5,
                    tension: 0.1,
                    spanGaps: false,
                    yAxisID: leftAxis.has(s.key) ? 'y' : 'y1'
                };
            });

            var ctx = document.getElementById('repoTrendChart');
            if (!ctx) return;

            var chart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels.map(function (ts) {
                        var d = new Date(ts);
                        return d.toLocaleString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
                    }),
                    datasets: datasets
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: { position: 'bottom' },
                        tooltip: {
                            callbacks: {
                                title: function (items) { return new Date(labels[items[0].dataIndex]).toLocaleString(); }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { maxRotation: 45, maxTicksLimit: 15 }
                        },
                        y: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            title: { display: true, text: 'Symbols / Files / Relationships' },
                            beginAtZero: true
                        },
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            title: { display: true, text: 'Classes / Methods / etc.' },
                            beginAtZero: true,
                            grid: { drawOnChartArea: false }
                        }
                    }
                }
            });

            document.querySelectorAll('.metric-card').forEach(function (card) {
                card.addEventListener('click', function () {
                    var metric = this.dataset.metric;
                    var ds = chart.data.datasets.find(function (d) { return d.label === metric; });
                    if (ds) {
                        ds.hidden = !ds.hidden;
                        chart.update();
                        this.classList.toggle('opacity-50');
                    }
                });
            });
        })();
    </script>
}
