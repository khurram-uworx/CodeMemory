@page
@model RepositoryDashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Repository Dashboard</h1>
    @if (Model.CanAddRepo)
    {
        <a asp-page="/Repos/Add" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Add Repo</a>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-bg-primary">
            <div class="card-body">
                <h5 class="card-title">Total Repos</h5>
                <p class="display-6 mb-0">@Model.TotalCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-success">
            <div class="card-body">
                <h5 class="card-title">Indexed</h5>
                <p class="display-6 mb-0">@Model.IndexedCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-warning">
            <div class="card-body">
                <h5 class="card-title">In Progress</h5>
                <p class="display-6 mb-0">@Model.InProgressCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-danger">
            <div class="card-body">
                <h5 class="card-title">Failed</h5>
                <p class="display-6 mb-0">@Model.FailedCount</p>
            </div>
        </div>
    </div>
</div>

@if (Model.Repos.Count == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i>
        No repositories registered.
        @if (Model.CanAddRepo)
        {
            <a asp-page="/Repos/Add">Add one now</a>
        }
    </div>
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Status</th>
                <th>Source</th>
                <th>Last Indexed</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var repo in Model.Repos)
            {
                <tr>
                    <td><strong>@repo.Name</strong></td>
                    <td><span class="badge @repo.BadgeClass">@repo.Status</span></td>
                    <td>
                        @if (!string.IsNullOrEmpty(repo.GitUrl))
                        {
                            <a href="@repo.GitUrl" target="_blank" class="text-break">@repo.GitUrl</a>
                        }
                        else
                        {
                            <code class="text-break">@repo.LocalPath</code>
                        }
                    </td>
                    <td>@(repo.LastIndexedAt?.ToString("g") ?? "—")</td>
                    <td>
                        <a asp-page="/Repos/Components" asp-route-name="@repo.Name" class="btn btn-sm btn-outline-info" title="Components">
                            <i class="bi bi-boxes"></i>
                        </a>
                        <a asp-page="/Repos/Metrics" asp-route-name="@repo.Name" class="btn btn-sm btn-outline-warning" title="Metrics">
                            <i class="bi bi-graph-up"></i>
                        </a>
                    </td>
                </tr>
                @if (!string.IsNullOrEmpty(repo.ErrorMessage))
                {
                    <tr class="table-danger">
                        <td colspan="5"><small>@repo.ErrorMessage</small></td>
                    </tr>
                }
            }
        </tbody>
    </table>
}
