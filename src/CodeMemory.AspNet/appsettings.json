{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=App_Data/registry.db",
    "PgVector": "Host=..",
    "SqlServer": "Server=.."
  },
  "Storage": {
    // [inmemory | sqlite | pgvector | sqlserver]
    "Provider": "inmemory",

    // CodeMemory PgVector Provider configs (WIP)
    "PgVector": {
      "Schema": "public",
      "Index": {
        "Enabled": true,
        "Method": "hnsw",
        "DistanceFunction": "vector_cosine_ops",
        "M": 16,
        "EfConstruction": 64
      }
    }
  },
  // Embedding provider: "ngram" (default), "onnx", "sk-connector-onnx", "ollama"
  // ONNX providers require the bge-micro-v2 model: run download-models.ps1
  // Ollama requires Ollama server running at OllamaEndpoint with OllamaModel pulled
  "Embedding": {
    "Provider": "ngram",
    "OnnxModelPath": "models/bge-micro-v2/model.onnx",
    "OnnxVocabPath": "models/bge-micro-v2/vocab.txt",
    "OllamaEndpoint": "http://localhost:11434",
    "OllamaModel": "all-minilm"
  },
  "RepoRegistry": {
    "CloneBasePath": "../../../.cloned-repos",
    "GitCommandTimeoutSeconds": 300,
    "EnableManualRepoAdd": true,
    "RebuildCron": "0 */6 * * *"
  },
  "Indexing": {
    "RepoTimeoutMinutes": 30,
    "RetryCount": 3,
    "RetryBaseDelaySeconds": 2
  },
  //"Repositories": {
  //  "memori": "https://github.com/khurram-uworx/memori",
  //  "codememory": "https://github.com/khurram-uworx/codememory"
  //}
}
