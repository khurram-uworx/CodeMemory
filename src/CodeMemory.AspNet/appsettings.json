{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=App_Data/registry.db",
    "PgVector": "Host=..",
    "SqlServer": "Server=.."
  },
  "Storage": {
    // [inmemory | sqlite | pgvector | sqlserver]
    "Provider": "inmemory"
  },
  "RepoRegistry": {
    "CloneBasePath": "./cloned-repos",
    "CloneTimeoutSeconds": 300
  },
  "Indexing": {
    "RepoTimeoutMinutes": 30,
    "RetryCount": 3,
    "RetryBaseDelaySeconds": 2
  }
}
